samen_core/cover/
cover/

# ExDoc HTML output (mix docs) — dev-only, never committed
samen_core/doc/
samen_web/doc/

# UXD-02 Seam B: run-varying provenance sidecars for the T5.4/T5.5 game-day reports
# (Generated: timestamp, KMS scratch-keystore path, timestamp_utc) — never committed (E-03)
driftwood/reports/*.sidecar.*

# planning workspace + orchestrator state — never committed
spec/
_orch/

# earlier baton runs, moved in from siblings
_orch-*/

# WS-E sabotage harness (scripts/sabotage.sh): the throwaway replay worktree + its
# per-app mix build cache. The harness applies every sabotage patch THERE, never in
# the main checkout, so this is a scratch build cache — never committed.
.sabotage/

# The PARALLEL sabotage driver (scripts/sabotage_parallel.sh): one replay worktree + mix build
# cache PER SLICE, plus its logs, its per-slice locks and the driver lock. Same posture as
# `.sabotage/` above — scratch, never committed. It MUST stay ignored: the harness replicates the
# main checkout's UNTRACKED files into every replay tree, so an un-ignored scratch root gets
# copied into each tree (thousands of build-cache files, one level deeper on every run) and a run
# hangs in that copy instead of replaying patches.
.sabotage-parallel/

# Prod-compile gate (scripts/prod_compile_gate.sh): the per-app MIX_ENV=prod build
# root (`mix deps.get --only prod` + `mix compile --force` + the release). A scratch
# build cache that must never shadow the real `_build/prod` — never committed.
.prod_gate/

# Generated documentation
_site/
*/doc/
