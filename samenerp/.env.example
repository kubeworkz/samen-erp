# =============================================================================
# Samenerp Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=samenerp
POSTGRES_PORT=5432

# Database URL (used by Ecto)
DATABASE_URL=ecto://postgres:changeme_in_production@db/samenerp

# -----------------------------------------------------------------------------
# Phoenix Configuration
# -----------------------------------------------------------------------------
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=your_secret_key_base_here

# Production domain
PHX_HOST=your-domain.com

# Server port (default: 4050)
PORT=4050

# Enable server (set to true in production)
PHX_SERVER=true

# -----------------------------------------------------------------------------
# KMS Configuration
# -----------------------------------------------------------------------------
# Options: file_backed (dev/test), aws_kms_dynamo (prod)
SAMEN_KMS_ADAPTER=file_backed

# For file_backed adapter (dev/test only)
SAMEN_KMS_FILE_PATH=/app/data/kms_store.json

# For AWS KMS adapter (prod)
# SAMEN_KMS_AWS_REGION=us-east-1
# SAMEN_KMS_AWS_ACCESS_KEY_ID=your_access_key
# SAMEN_KMS_AWS_SECRET_ACCESS_KEY=your_secret_key
# SAMEN_KMS_DYNAMO_TABLE=samenerp-kms-keys

# -----------------------------------------------------------------------------
# HuggingFace AI Integration (BYOK)
# -----------------------------------------------------------------------------
# Users bring their own HuggingFace API keys
# No server-side configuration needed for the API itself
# The app encrypts and stores user keys securely

# -----------------------------------------------------------------------------
# Stripe Billing (Optional)
# -----------------------------------------------------------------------------
# Get your keys from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Email Service Provider (Optional)
# -----------------------------------------------------------------------------
# Options: postmark, ses, resend
# SAMEN_ESP_PROVIDER=postmark

# For Postmark:
# SAMEN_POSTMARK_API_KEY=your_postmark_api_key

# For AWS SES:
# SAMEN_SES_REGION=us-east-1
# SAMEN_SES_ACCESS_KEY=your_access_key
# SAMEN_SES_SECRET_KEY=your_secret_key

# For Resend:
# SAMEN_RESEND_API_KEY=your_resend_api_key

# -----------------------------------------------------------------------------
# Observability (Optional)
# -----------------------------------------------------------------------------
# OpenTelemetry
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Sentry Error Tracking
# SENTRY_DSN=https://your-sentry-dsn

# -----------------------------------------------------------------------------
# Redis (Optional, for rate limiting)
# -----------------------------------------------------------------------------
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Release Configuration
# -----------------------------------------------------------------------------
# Node name for clustering
RELEASE_NODE=samenerp@127.0.0.1

# Cookie for distributed Erlang
RELEASE_COOKIE=your_release_cookie_here

# -----------------------------------------------------------------------------
# Development Overrides
# -----------------------------------------------------------------------------
# Uncomment these for local development
# MIX_ENV=dev
# DATABASE_URL=ecto://postgres:postgres@localhost/samenerp_dev
# SECRET_KEY_BASE=dev_secret_key_base_that_is_at_least_64_bytes_long_for_development_purposes_only
# PHX_HOST=localhost
# PORT=4050
