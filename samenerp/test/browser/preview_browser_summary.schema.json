{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:samen:browser-summary-preview",
  "x-schema-version": 1,
  "title": "Samen browser test summary preview",
  "description": "Sample JSON emitted by preview_browser_summary.js for the browser test's CI summary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "threshold",
    "threshold_source",
    "duration_seconds",
    "metrics_artifact",
    "failure_artifact"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Must equal the schema's x-schema-version; the validator checks that value."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ]
    },
    "threshold": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "threshold_source": {
      "type": "string",
      "minLength": 1
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "metrics_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "size_bytes",
        "size",
        "retention_days",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        }
      }
    },
    "failure_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "produced",
        "retention_days",
        "files"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "produced": {
          "type": "boolean"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "name",
              "size_bytes",
              "size",
              "retention_days",
              "url"
            ],
            "properties": {
              "section": {
                "type": "string",
                "enum": [
                  "Logs",
                  "Screenshots",
                  "Reports"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "size": {
                "type": "string",
                "minLength": 1
              },
              "retention_days": {
                "type": "integer",
                "minimum": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https?://\\S+$"
              }
            }
          }
        }
      }
    }
  }
}
