#!/usr/bin/env bash
# Windows shim: psql (repo root scripts/win-shims — same class as the
# sabotage.sh sha256sum fallback, E1).
#
# The dev Postgres runs in the `samen-pg` Docker container; hosts without the
# PG client tools get this shim, which proxies to `docker exec` inside the
# container. Local socket connections inside the official postgres image are
# TRUST-authed for POSTGRES_USER, so no password handling is needed.
#
# * `-h HOST` is only accepted for localhost targets — anything else must fail
#   loud rather than silently redirect a remote connection into the container.
# * `-h`/`-p` are dropped (container-local socket); every other flag is
#   forwarded verbatim.
# * `-f FILE` names a HOST-side file the container cannot see, so it is
#   rewritten to a stdin redirect (`docker exec -i ... < FILE`).
#
# Only wired in by callers (pitr_gameday_sim.sh) when no real host psql exists,
# and only against the local dev container. Set SAMEN_PG_CONTAINER to override.

set -uo pipefail

# Resolve container: explicit SAMEN_PG_CONTAINER wins; otherwise try the
# live container names in priority order (samenpg is the real dev container;
# samen-pg was a stale name that lingered as an exited container and caused
# `docker container inspect` to succeed while `docker exec` failed with
# "container is not running" — the T5.5 PITR drill's CREATE DATABASE never
# ran and Elixir got FATAL 3D000 invalid_catalog_name).
resolve_container() {
  if [[ -n "${SAMEN_PG_CONTAINER:-}" ]]; then
    echo "$SAMEN_PG_CONTAINER"
    return
  fi
  for c in samenpg samen-pg; do
    if [[ "$(docker container inspect --format '{{.State.Running}}' "$c" 2>/dev/null)" == "true" ]]; then
      echo "$c"
      return
    fi
  done
  # Fallback to the first candidate so the error message names it.
  echo "samenpg"
}
CONTAINER="$(resolve_container)"

if [[ "$(docker container inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" != "true" ]]; then
  echo "psql shim: container '$CONTAINER' not running (install a real psql client for non-docker use)" >&2
  exit 127
fi

host=""
file=""
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h)
      host="${2:-}"
      if [[ "$host" != "localhost" && "$host" != "127.0.0.1" && "$host" != "::1" ]]; then
        echo "psql shim: non-local -h '$host' unsupported — install a real psql client" >&2
        exit 127
      fi
      shift 2
      ;;
    -p) shift 2 ;;
    -f)
      file="${2:-}"
      shift 2
      ;;
    --host=*)
      host="${1#*=}"
      if [[ "$host" != "localhost" && "$host" != "127.0.0.1" && "$host" != "::1" ]]; then
        echo "psql shim: non-local --host '$host' unsupported — install a real psql client" >&2
        exit 127
      fi
      shift
      ;;
    *) args+=("$1"); shift ;;
  esac
done

if [[ -n "$file" ]]; then
  exec docker exec -i "$CONTAINER" psql "${args[@]}" < "$file"
else
  exec docker exec -i "$CONTAINER" psql "${args[@]}"
fi
