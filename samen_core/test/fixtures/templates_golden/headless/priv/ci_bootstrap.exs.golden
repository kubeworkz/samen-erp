# Acme ci.sh bootstrap (run under MIX_ENV=test): recreate + migrate the
# acme_test DB so the standalone verifier tasks (which query the LIVE DB) have a
# fully-migrated schema. Idempotent.

alias Acme.Repo

kms_key_dir =
  Path.join(System.tmp_dir!(), "acme_keystore_ci_#{System.system_time(:nanosecond)}")

File.rm_rf!(kms_key_dir)
Application.put_env(:samen_core, :kms_key_dir, kms_key_dir)

# Tolerant boot: a contended DROP/CREATE (the root gate runs sibling app gates concurrently on
# one Postgres) must not crash the bootstrap — it creates if absent, retries, and raises only
# when the database genuinely cannot be brought up. See `Samen.TestDb`.
Samen.TestDb.boot!(Repo)

IO.puts("acme ci bootstrap: DB migrated")
