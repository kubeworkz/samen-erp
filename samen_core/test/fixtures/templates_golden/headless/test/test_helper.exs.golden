# Fresh KMS keystore + migrated DB before the suite (mirrors ci_bootstrap).
kms_key_dir =
  Path.join(System.tmp_dir!(), "acme_keystore_test_#{System.system_time(:nanosecond)}")

File.rm_rf!(kms_key_dir)
Application.put_env(:samen_core, :kms_key_dir, kms_key_dir)
System.at_exit(fn _ -> File.rm_rf!(kms_key_dir) end)

alias Acme.Repo

# Tolerant boot: a `mix test` run that follows another suite can find the database still held
# (its pool closing), so the drop is best-effort and the create retries. See `Samen.TestDb`.
Samen.TestDb.boot!(Repo)
Ecto.Adapters.SQL.Sandbox.mode(Repo, :manual)

ExUnit.start()
