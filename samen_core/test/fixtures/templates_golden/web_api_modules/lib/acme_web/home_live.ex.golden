defmodule AcmeWeb.HomeLive do
  @moduledoc """
  The Acme landing MENU (scaffolded by `mix samen.gen.app --modules`).

  Surfaces the mounted framework surfaces as real NAVIGATION using the Samen UI kit
  (`Samen.UI.app_shell`/`sidebar`/`module_nav`/`nav_group`/`nav_item`) — so a builder SEES
  every mounted surface as a menu, not an orphaned route. The inherited groups come from the
  framework `module_nav/1`, CONSTRAINED to the surfaces THIS router actually mounts via
  `surfaces={[:inbox, :billing, :settings]}` (X1 / ADR-045 §4.1): this app mounts billing +
  notifications always, plus the selected `--modules`, and never CRM/Support/Marketing/
  Automation — so the nav renders ONLY those groups and never a dead link that would raise
  `Phoenix.Router.NoRouteError` on the first click.

  The `--modules` surfaces with a GATED framework group (Files → Documents, Search → Discover)
  render from `module_nav/1` itself, off the SAME `:files_path`/`:search_path` mount labels the
  router threads — passed EXPLICITLY here, because this landing is static and has no
  `Samen.Web.Mount` to resolve them from — as does Settings (Workspace, via the `surfaces`
  filter above). ONLY the surfaces that own no framework group (the CSV import ACTION, which
  has no destination page) ride the `:extra` "Product" group; listing a gated surface here as
  well would put the same item in the sidebar twice. Statically rendered (no per-request field
  value), so it has no masking surface.
  """
  use Phoenix.LiveView
  import Samen.UI

  @impl Phoenix.LiveView
  def mount(params, _session, socket) do
    {:ok, assign(socket, org_id: params["org"])}
  end

  @impl Phoenix.LiveView
  def render(assigns) do
    ~H"""
    <.app_shell>
      <:sidebar>
        <.sidebar title="Acme" subtitle="Samen vertical">
          <.module_nav
            org_id={@org_id}
            active={nil}
            surfaces={[:inbox, :billing, :settings]} files_path="/files" search_path="/search"
          >
            <:extra>
              <.nav_group label="Product">
                <.nav_item label="CSV import" href={"/csv/import/record?org=#{@org_id}"} />
              </.nav_group>
            </:extra>
          </.module_nav>
        </.sidebar>
      </:sidebar>
      <.topbar title="Acme" crumbs={["Home", "Menu"]} />
      <div class="card" style="padding:18px 20px">
        <p style="margin:0">
          A Samen vertical scaffolded by <code>mix samen.gen.app --modules</code>. Every
          framework end-user surface in this sidebar is mounted from <code>samen_web</code> at
          ≈0 authored LOC and inherits the shared Samen shell + masking by construction.
        </p>
      </div>
    </.app_shell>
    """
  end
end
