defmodule <%= module %>.Repo.Migrations.MountDocsScope do
  @moduledoc """
  WS-Notes Phase 1 / ADR-053 — mounts the Docs scope into this app for the FIRST
  time (Doc + Note + the new block model), and catalogs all four resources in the
  SAME migration transaction (ADR-004 catalog-in-tx). Mirrors this app's own
  `MountPrimitivesScope`.

    * `<%= d_doc %>_doc` — Doc: `title`, `body` (plain, `FreeTextScan`-guarded) /
      🔒 `pii_<%= d_doc %>_secure_body` (`vault: :pii_doc_body`), the generic
      `(subject_key, subject_id)` object-ref anchor, plus the ADR-053 page-tree
      columns `<%= d_doc %>_parent_doc_id` (same-org — R4's org half),
      `<%= d_doc %>_icon`, `<%= d_doc %>_position` (integer ordinal among siblings,
      ADR-053 §8 O2) and `<%= d_doc %>_revision` (optimistic concurrency).
      Archivable (ADR-040 §5.9).
    * `<%= d_note %>_note` — Note: same posture (`vault: :pii_note_body`), same
      anchor. Archivable.
    * `<%= d_block %>_doc_block` — one typed BLOCK row per page: `<%= d_block %>_type`
      is a bounded enum whose `<%= d_block %>_metadata`/`<%= d_block %>_checked` are
      validated against it by `Samen.Scopes.Docs.BlockShape` on every governed
      write (the enum constraint alone cannot express "`language` only on `code`");
      `<%= d_block %>_position` is scoped to `<%= d_block %>_parent_block_id`; and
      🔒 `pii_<%= d_block %>_text_secure` is the vaulted half of the per-block
      `text`/`text_secure` pair (`vault: :pii_block_text`) — block-level masking
      granularity, at the column level where the PII verifiers already look.
      Archivable.
    * `<%= d_link %>_doc_link` — one RESOLVED `[[Title]]` edge; both endpoints
      same-org (`Samen.Policy.SameOrgFk`, R13); unique per
      `(source_doc_id, target_doc_id)`. Not archivable — a pure edge row.

  ## Abbrevs

  `<%= d_doc %>`/`<%= d_note %>`/`<%= d_block %>`/`<%= d_link %>` are prefix-derived
  and reserved through `mix samen.abbrev.reserve` under host `<%= otp_app %>`
  (ADR-023) — never hand-edited into `priv/abbrev_registry.json`.

  ## Down

  `down/0` drops all four tables and their catalog rows (fresh mount — the
  bootstrap form of `catalog_sync_down/1`).
  """
  # An ADDITIVE (expand) migration: `down/0` is a clean round trip, so the tree
  # down-check exercises it in this app's gate (`mix samen.verify.migrations`).
  use Samen.Migration, phase: :expand

  @resources [
    <%= module %>.Docs.Doc,
    <%= module %>.Docs.Note,
    <%= module %>.Docs.DocBlock,
    <%= module %>.Docs.DocLink
  ]

  def up do
    create table(:<%= d_doc %>_doc, primary_key: false) do
      add(:<%= d_doc %>_title, :text, null: false)
      add(:<%= d_doc %>_body, :text)
      add(:<%= d_doc %>_subject_key, :text)
      add(:<%= d_doc %>_subject_id, :uuid)
      add(:<%= d_doc %>_custom, :map)
      add(:<%= d_doc %>_owner_id, :uuid)
      add(:<%= d_doc %>_icon, :text)
      add(:<%= d_doc %>_position, :bigint, null: false, default: 0)
      add(:<%= d_doc %>_revision, :bigint, null: false, default: 1)
      add(:<%= d_doc %>_parent_doc_id, :uuid)
      add(:pii_<%= d_doc %>_secure_body, :text)
      add(:<%= d_doc %>_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:<%= d_doc %>_org_id, :uuid, null: false)
      add(:<%= d_doc %>_inserted_at, :utc_datetime, null: false)
      add(:<%= d_doc %>_updated_at, :utc_datetime, null: false)
      add(:<%= d_doc %>_archived_at, :utc_datetime_usec)
    end

    create(index(:<%= d_doc %>_doc, [:<%= d_doc %>_org_id]))
    create(index(:<%= d_doc %>_doc, [:<%= d_doc %>_subject_key, :<%= d_doc %>_subject_id]))
    create(index(:<%= d_doc %>_doc, [:<%= d_doc %>_parent_doc_id]))

    create table(:<%= d_note %>_note, primary_key: false) do
      add(:<%= d_note %>_body, :text)
      add(:<%= d_note %>_subject_key, :text)
      add(:<%= d_note %>_subject_id, :uuid)
      add(:<%= d_note %>_custom, :map)
      add(:<%= d_note %>_owner_id, :uuid)
      add(:pii_<%= d_note %>_secure_body, :text)
      add(:<%= d_note %>_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:<%= d_note %>_org_id, :uuid, null: false)
      add(:<%= d_note %>_inserted_at, :utc_datetime, null: false)
      add(:<%= d_note %>_updated_at, :utc_datetime, null: false)
      add(:<%= d_note %>_archived_at, :utc_datetime_usec)
    end

    create(index(:<%= d_note %>_note, [:<%= d_note %>_org_id]))
    create(index(:<%= d_note %>_note, [:<%= d_note %>_subject_key, :<%= d_note %>_subject_id]))

    create table(:<%= d_block %>_doc_block, primary_key: false) do
      add(:<%= d_block %>_parent_block_id, :uuid)
      add(:<%= d_block %>_position, :bigint, null: false, default: 0)
      add(:<%= d_block %>_type, :text, null: false)
      add(:<%= d_block %>_text, :text)
      add(:<%= d_block %>_checked, :boolean)
      add(:<%= d_block %>_metadata, :map, default: %{})
      add(:<%= d_block %>_revision, :bigint, null: false, default: 1)
      add(:<%= d_block %>_doc_id, :uuid, null: false)
      add(:pii_<%= d_block %>_text_secure, :text)
      add(:<%= d_block %>_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:<%= d_block %>_org_id, :uuid, null: false)
      add(:<%= d_block %>_inserted_at, :utc_datetime, null: false)
      add(:<%= d_block %>_updated_at, :utc_datetime, null: false)
      add(:<%= d_block %>_archived_at, :utc_datetime_usec)
    end

    create(index(:<%= d_block %>_doc_block, [:<%= d_block %>_org_id]))
    create(index(:<%= d_block %>_doc_block, [:<%= d_block %>_doc_id, :<%= d_block %>_position]))
    create(index(:<%= d_block %>_doc_block, [:<%= d_block %>_parent_block_id]))

    create table(:<%= d_link %>_doc_link, primary_key: false) do
      add(:<%= d_link %>_anchor_text, :text, null: false)
      add(:<%= d_link %>_source_doc_id, :uuid, null: false)
      add(:<%= d_link %>_target_doc_id, :uuid, null: false)
      add(:<%= d_link %>_id, :uuid, null: false, default: fragment("gen_random_uuid()"), primary_key: true)
      add(:<%= d_link %>_org_id, :uuid, null: false)
      add(:<%= d_link %>_inserted_at, :utc_datetime, null: false)
      add(:<%= d_link %>_updated_at, :utc_datetime, null: false)
    end

    create(index(:<%= d_link %>_doc_link, [:<%= d_link %>_target_doc_id]))
    create(unique_index(:<%= d_link %>_doc_link, [:<%= d_link %>_source_doc_id, :<%= d_link %>_target_doc_id]))

    catalog_sync(@resources)
  end

  def down do
    catalog_sync_down(@resources)

    drop(table(:<%= d_link %>_doc_link))
    drop(table(:<%= d_block %>_doc_block))
    drop(table(:<%= d_note %>_note))
    drop(table(:<%= d_doc %>_doc))
  end
end
